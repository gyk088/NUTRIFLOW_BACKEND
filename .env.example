# Fastify
FASTIFY_PORT=
FASTIFY_ADDRESS=0.0.0.0

# Postgres
DB_NAME=
DB_USER= 
DB_PASS= 
DB_PORT= 
DB_HOST= 

# SMTP для отправки писем (Mailer, src/bll/utils/Mailer.js)
SMTP_PASS=
SMTP_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# URL фронтенда — используется для формирования ссылки восстановления пароля
FRONTEND_URL= 
# Базовый URL раздачи загруженных файлов
FILE_BASE_URL=

# Google Sign-In — OAuth Client ID(ы) из Google Cloud Console (Credentials), нужен
# хотя бы один. Используются как allowed audience при проверке id_token
# (AuthService.loginWithGoogle). Тип клиента (Web/iOS/Android) должен совпадать
# с тем, что настроен на фронтенде в NutriFlow/.env.local.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Sign in with Apple — bundle ID приложения (не Services ID: это нативный флоу
# через expo-apple-authentication), сверяется как aud в identityToken
# (AuthService.loginWithApple).
APPLE_BUNDLE_ID=com.nutriFlow

# Gemini API — ключ из https://aistudio.google.com/apikey (заполнить самостоятельно)
GEMINI_API_KEY=
GEMINI_MODEL=


 